# Central FastAPI Backend Settings
MONITOR_BACKEND_HOST=0.0.0.0
MONITOR_BACKEND_PORT=8000
# Optional PostgreSQL URL (Render sets DATABASE_URL automatically; leave blank locally for SQLite)
DATABASE_URL=
MONITOR_DB_PATH=data/monitoring_system.db
MONITOR_FAISS_DIR=data/faiss_live

# Security & Authentication (REQUIRED in production)
MONITOR_ADMIN_KEY=replace-with-strong-random-admin-key
MONITOR_ADMIN_USER=admin
MONITOR_ADMIN_PASSWORD=replace-with-strong-operator-password
MONITOR_JWT_SECRET=replace-with-32plus-char-random-secret
CORS_ALLOWED_ORIGINS=https://your-dashboard.streamlit.app,http://localhost:8501

# Enrollment & Retention
MONITOR_ENROLLMENT_TOKEN=
DEVICE_OFFLINE_SECONDS=30
EVENT_RETENTION_DAYS=30
TELEMETRY_RETENTION_DAYS=14
ALERT_WEBHOOK_URL=

# Dashboard Configuration (used by app.py / Streamlit Community Cloud)
BACKEND_URL=http://127.0.0.1:8000

# Optional Cloud LLM for Conversational Assistant (leaves offline deterministic mode if blank)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
